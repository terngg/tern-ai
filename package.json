{
  "name": "tern-ai",
  "version": "0.3.0",
  "description": "Terminal AI coding assistant for the documented GTPS Hosting Lua engine",
  "type": "module",
  "bin": {
    "tern": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/gtps-lua-api.md",
    "docs/engine-notes.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "packages/core",
    "apps/web"
  ],
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "npm run build:cli && npm run build:web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint src tests scripts apps/web/app apps/web/lib apps/web/next.config.ts packages/core/src && tsc --noEmit && npm run typecheck --workspace @tern-ai/web",
    "dev:web": "npm run dev --workspace @tern-ai/web",
    "build:web": "npm run build --workspace @tern-ai/web",
    "prepack": "npm run build:cli",
    "test:web": "playwright test",
    "build:cli": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "commander": "^14.0.0",
    "diff": "^9.0.0",
    "luaparse": "^0.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/luaparse": "^0.2.12",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terngg/tern-ai.git"
  },
  "homepage": "https://github.com/terngg/tern-ai#readme",
  "bugs": {
    "url": "https://github.com/terngg/tern-ai/issues"
  },
  "keywords": [
    "gtps",
    "lua",
    "cli",
    "coding-assistant",
    "gemini",
    "openrouter",
    "typescript"
  ]
}
